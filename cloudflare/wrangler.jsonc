{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xenoplayer-sharing-hub",
  "main": "src/index.js",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "assets": {
    "directory": "../web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/s/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xenoplayer-sharing-hub",
      "database_id": "REPLACE_WITH_EXISTING_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "REPLACE_WITH_EXISTING_R2_BUCKET_NAME"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "vars": {
    "MAX_UPLOAD_BYTES": "104857600"
  }
}
