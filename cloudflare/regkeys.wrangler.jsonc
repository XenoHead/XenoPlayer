{
  // Standalone registration-key validation Worker.
  // Deployed separately from the sharing hub so the endpoint stays reachable
  // by the desktop app even while the sharing hub hostname is behind Cloudflare Access.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xenoplayer-regkeys",
  "main": "src/reg_key_worker.js",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xenoplayer-sharing-hub",
      "database_id": "d06fe9bd-e7f1-40dc-a72a-1dd1d6c7738c",
      "migrations_dir": "migrations"
    }
  ]
}
